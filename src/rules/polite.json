    "pattern": "(?:what(?:['’]s| is) the (?:status|update|progress) (?:of|on|for|regarding)|any updates? (?:on|regarding|about|for)|is there any update (?:on|regarding|about))",
    "replacement": "could you please share an update on{?}",
    "alternatives": [
      "may I have an update on{?}",
      "I am following up on{.}",
      "I wanted to check on the status of{.}",
      "do you have an update on{?}"
    ],
    "tone": "polite",
    "priority": 85,
    "context": "Follow-ups",
    "description": "Several ways to phrase the same sentence — pick the one that fits."
  },
